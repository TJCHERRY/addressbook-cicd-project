pipeline {
    agent any

    stages {
        stage('Stage1: Checkout Code from remote origin') {
            steps {
                checkout scmGit(branches: [[name: '*/master']], extensions: [], userRemoteConfigs: [[credentialsId: 'jenkins-ssh-git', url: 'git@github.com:TJCHERRY/addressbook-cicd-project.git']])
            }
        }
        stage('Stage2: Compile Code'){
            steps{
            script {
                 def result = sh(
                    script: 'mvn compile',
                    returnStatus: true
                    )

                echo "Maven exit code: ${result}"
                }
            }
        }
        stage('Stage3: Test code'){
            steps{
                sh 'mvn test'
            }
        }
         stage('QA of the Code') {
            steps {
                // Generates the checkstyle-result.xml file inside target/
                sh 'mvn checkstyle:checkstyle'
            }
            post {
                always {
                    // Visualizes findings directly in the Jenkins Build Dashboard
                    recordIssues tools: [checkStyle(pattern: '**/target/checkstyle-result.xml')]
                }
            }
        }
        stage('Stage5 : Package The Code'){
            steps{
            sh 'mvn package'
            }
        }
        stage("deploy the project"){
            steps{
            sh "sudo cp /var/lib/jenkins/workspace/my-addressbook-pipeline/target/addressbook.war /root/apache-tomcat-9.0.120/webapps"
            }
        }

    }
}
